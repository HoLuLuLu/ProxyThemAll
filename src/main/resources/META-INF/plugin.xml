<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>org.holululu.proxythemall</id>
    <name>ProxyThemAll</name>
    <vendor>holululu</vendor>

    <depends>com.intellij.modules.platform</depends>
    <!-- Git4Idea is bundled in all IntelliJ-based IDEs and provides the configured git executable.
         The Gradle plugin is deliberately not required: Gradle support only reads and writes
         gradle.properties, so it needs no Gradle plugin API. -->
    <depends>Git4Idea</depends>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="ProxyThemAll.Notifications" displayType="BALLOON"/>
        <statusBarWidgetFactory id="ProxyThemAll.StatusBar"
                                implementation="org.holululu.proxythemall.widgets.ProxyStatusBarWidgetFactory"/>
        <applicationConfigurable parentId="tools"
                                 instance="org.holululu.proxythemall.settings.ProxyThemAllConfigurable"
                                 id="org.holululu.proxythemall.settings"
                                 displayName="ProxyThemAll"/>
        <!-- Services are registered via the @Service annotation, not here -->
        <postStartupActivity implementation="org.holululu.proxythemall.services.ProxyThemAllStartupActivity"/>
    </extensions>

    <actions>
        <!-- The text is replaced at runtime with the action the current proxy state allows -->
        <action id="ProxyThemAll.Action" class="org.holululu.proxythemall.actions.ProxyThemAllAction"
                text="Toggle Proxy (ProxyThemAll)"
                description="Enable or disable the IDE proxy and synchronize Git and Gradle">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
